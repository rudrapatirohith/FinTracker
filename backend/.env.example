# Local development only. Never commit your real .env file.
POSTGRES_USER=fintracker
POSTGRES_PASSWORD=fintracker
POSTGRES_DB=fintracker

# The API runs on Windows; PostgreSQL runs in Docker and is exposed on localhost.
DATABASE_URL=postgresql+psycopg://fintracker:fintracker@127.0.0.1:5433/fintracker

APP_NAME=FinTracker API
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
